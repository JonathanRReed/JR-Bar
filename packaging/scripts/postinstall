#!/bin/sh
# JR-Bar component postinstall. The package owns its payload and nothing
# else: no LaunchAgents, no /usr/local links, no hooks, no receipts. The app
# registers itself as a login item and installs provider hooks on its first
# launch of a new version; a home-directory install ($2 under ~/Applications)
# is the same payload for one user.
set -eu

INSTALL_LOCATION="${2:-/Applications}"
APP_BINARY="$INSTALL_LOCATION/JR-Bar.app/Contents/MacOS/JR-Bar"
CORE_BINARY="$INSTALL_LOCATION/JR-Bar.app/Contents/Helpers/jrbar-core.app/Contents/MacOS/jrbar-core"
HOOK_SHIM="$INSTALL_LOCATION/JR-Bar.app/Contents/Helpers/jrbar-hook"

for required in "$APP_BINARY" "$CORE_BINARY" "$HOOK_SHIM"; do
    if [ ! -x "$required" ]; then
        /bin/echo "JR-Bar postinstall: missing or not executable: $required" >&2
        exit 1
    fi
done

/bin/echo "JR-Bar postinstall: installed $INSTALL_LOCATION/JR-Bar.app; open it to finish (login item, provider hooks)"
exit 0
